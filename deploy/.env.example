# KoroFarm STAGING stack (deploy/compose.staging.yml). Placeholders only.
# Copy to deploy/.env ON THE SERVER and fill in there (chmod 600). deploy/.env is gitignored: never commit it,
# never paste its values into chat, issues or pull requests. See docs/product/R1_PRODUCT_OWNER_SETUP_GUIDE.md.

# --- Environment -----------------------------------------------------------------------------------------------
APP_ENV=staging
RELEASE=staging

# --- Domains (DNS A/AAAA records point at this server) ------------------------------------------------------
APP_DOMAIN=staging.example.org
API_DOMAIN=api.staging.example.org
# Let's Encrypt expiry notices
ACME_EMAIL=ops@example.org

# --- Supabase (Project Settings > API Keys; Connect button for database strings) ----------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Public by design; ships in the browser bundle.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# The secret key (sb_secret_...) is NOT used by KoroFarm. Do not put it here.

# Application connection: Supavisor SESSION pooler, port 5432, TLS required. Password URL-encoded.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:URL_ENCODED_PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# Sessions: leave AUTH_SESSION_VERIFICATION unset. Staging verifies tokens against the project's signing keys and
# checks auth.sessions on every request; "remote" is refused at startup.
# Migrations: leave empty to use DATABASE_URL (fine with the session pooler). Never the 6543 transaction pooler.
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Access requests ---------------------------------------------------------------------------------------------
# The one account allowed to review self-service access requests. Empty: nobody can (fail closed).
ACCESS_REQUEST_REVIEWER_EMAIL=

# --- Worker ------------------------------------------------------------------------------------------------------
WORKER_POLL_SECONDS=2

# --- Recovery model (OFF). Turning it on in staging requires the product owner's recorded approval reference. ---
AGENT_MODEL_PROVIDER=none
AGENT_MODEL_STAGING_APPROVAL=
MINIMAX_API_KEY=
MINIMAX_MODEL=
NEBIUS_API_KEY=
NEBIUS_MODEL=

# --- Outbound notifications (R1 WP5, M3). No messaging provider is connected. ------------------------------------
# none (default): messages are recorded and marked "not sent"; synthetic: recorded as sent, never leaves the server
# (refused in production). Any other value is refused at startup until a real provider is reviewed and approved.
NOTIFICATION_PROVIDER=none
# Future SMS / WhatsApp / email provider credentials go here only after approval (docs/integrations/MESSAGING.md).
# MESSAGING_PROVIDER=
# MESSAGING_API_KEY=
# MESSAGING_SENDER_ID=

# --- Agricultural intelligence (R1 WP5 preparation). Offline imports only; nothing is fetched. --------------------
# Evidence-grounded answers stay off. Turning them on also needs the recovery-model gate above (never production;
# staging only with an approval reference) and licence-approved sources (docs/integrations/ML_AND_LLM.md).
AGRI_LLM_ENABLED=false
AGRI_LLM_MAX_INPUT_TOKENS=6000
# FAOSTAT and Ministry of Agriculture files are downloaded by a person and imported from a local path
# (python -m src.backend.scripts.agri_import). No API key exists or is needed for either today.

# --- Monitoring and logging ------------------------------------------------------------------------------------
# The uptime monitor watches https://API_DOMAIN/health/worker (setup guide section 3). No log-shipping service yet.
# LOG_SHIPPING_ENDPOINT=
