# KoroFarm STAGING stack (deploy/compose.staging.yml). Placeholders only.
# Copy to deploy/.env ON THE SERVER and fill in there (chmod 600). deploy/.env is gitignored: never commit it,
# never paste its values into chat, issues or pull requests. See docs/product/R1_PRODUCT_OWNER_SETUP_GUIDE.md.

# --- Environment -----------------------------------------------------------------------------------------------
APP_ENV=staging
RELEASE=staging

# --- Domains (DNS A/AAAA records point at this server) ------------------------------------------------------
APP_DOMAIN=staging.example.org
API_DOMAIN=api.staging.example.org
# Let's Encrypt expiry notices
ACME_EMAIL=ops@example.org

# --- Supabase (Project Settings > API Keys; Connect button for database strings) ----------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Public by design; ships in the browser bundle.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# The secret key (sb_secret_...) is NOT used by KoroFarm. Do not put it here.

# Application connection: Supavisor SESSION pooler, port 5432, TLS required. Password URL-encoded.
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:URL_ENCODED_PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
# Migrations: leave empty to use DATABASE_URL (fine with the session pooler). Never the 6543 transaction pooler.
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Access requests ---------------------------------------------------------------------------------------------
# The one account allowed to review self-service access requests. Empty: nobody can (fail closed).
ACCESS_REQUEST_REVIEWER_EMAIL=

# --- Worker ------------------------------------------------------------------------------------------------------
WORKER_POLL_SECONDS=2

# --- Recovery model (OFF). Turning it on in staging requires the product owner's recorded approval reference. ---
AGENT_MODEL_PROVIDER=none
AGENT_MODEL_STAGING_APPROVAL=
MINIMAX_API_KEY=
MINIMAX_MODEL=
NEBIUS_API_KEY=
NEBIUS_MODEL=
