# KoroFarm frontend: LOCAL DEVELOPMENT template. Copy to src/frontend/.env.local (gitignored).
# Every NEXT_PUBLIC_* value is compiled into the browser bundle: public by design, never a secret.
# Deployed builds get these as Docker build arguments (deploy/frontend.Dockerfile), always with APP_MODE=live.

NEXT_PUBLIC_APP_MODE=live
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Must match the backend's ACCESS_REQUEST_REVIEWER_EMAIL to show the review queue; empty hides it.
NEXT_PUBLIC_ACCESS_REQUEST_REVIEWER_EMAIL=
