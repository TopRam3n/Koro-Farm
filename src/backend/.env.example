# KoroFarm backend: LOCAL DEVELOPMENT template. Placeholders only; copy to src/backend/.env (gitignored).
# The backend reads the process environment; load this file with your shell or IDE, for example:
#   set -a; . src/backend/.env; set +a
# Staging values belong in deploy/.env on the server (deploy/.env.example), never in this file.

# development | test | staging | production. Required; anything else stops startup.
APP_ENV=development

# Local PostgreSQL. In staging/production DATABASE_URL must be explicit, must not use these development
# credentials and must require TLS for a remote host (sslmode=require).
DATABASE_URL=postgresql+psycopg://korofarm:korofarm@localhost:5432/korofarm
# Optional connection settings (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_APPLICATION_NAME=korofarm
# DB_PREPARED_STATEMENTS=auto   # auto turns them off for Supabase's transaction pooler (port 6543)

# Supabase Auth. For local development use a Supabase project of your own, or the Supabase CLI (http://127.0.0.1:54321).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# AUTH_SESSION_VERIFICATION: development and test default to "remote" (GET /auth/v1/user); staging and production
# always verify tokens locally and check auth.sessions ("database"), and refuse "remote".

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_REQUEST_REVIEWER_EMAIL=

# Worker
# WORKER_POLL_SECONDS=2
# LEDGER_CHECK_SECONDS=3600
# HARVEST_REVERIFY_DAYS=7

# Recovery model provider: none by default. Development holds synthetic data only.
AGENT_MODEL_PROVIDER=none
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M3
# NEBIUS_API_KEY=
# NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Tests against PostgreSQL use a disposable database only (it is dropped and recreated):
# POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:55499/korofarm_test

# Outbound notifications (WP5 M3): none (default, nothing sent) or synthetic (recorded, never leaves the machine).
# NOTIFICATION_PROVIDER=none
# Agricultural evidence-grounded answers (WP5 preparation): off unless the model gate above also allows it.
# AGRI_LLM_ENABLED=false
# AGRI_LLM_MAX_INPUT_TOKENS=6000
